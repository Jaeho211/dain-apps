---
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import '../styles/global.css';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="다인이의 작은 아이디어와 앱, 그리고 만들며 배운 것들을 모으는 성장 기록입니다." />
    <meta name="theme-color" content="#faf8f3" />
    <title>다인이의 작은 작업실 · Dain's apps</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header wrap">
      <a class="brand" href={import.meta.env.BASE_URL}><span aria-hidden="true">✦</span> DAIN'S APPS</a>
      <nav aria-label="주 메뉴"><a href="#projects">앱 모음</a><a href="#about">작업실 소개</a></nav>
    </header>
    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <p class="eyebrow">A LITTLE IDEA, A NEW BEGINNING</p>
        <h1 id="hero-title">작은 호기심이<br />앱이 되는 곳<span class="accent">.</span></h1>
        <p class="hero-description">다인이의 작은 작업실에 오신 걸 환영해요.<br />직접 만든 앱과 그 안에 담긴 배움의 순간을 차곡차곡 모읍니다.</p>
        <a class="button" href="#projects">작품 둘러보기 <span aria-hidden="true">↓</span></a>
        <div class="hero-note"><span aria-hidden="true">✳</span> 천천히, 하나씩, 나만의 속도로.</div>
      </section>
      <section id="projects" class="projects-section" aria-labelledby="projects-title">
        <div class="section-heading"><div><p class="eyebrow">THE COLLECTION</p><h2 id="projects-title">앱 모음</h2></div><p>아이디어에서 시작하는 작은 작품들</p></div>
        <div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div>
      </section>
      <section id="about" class="about" aria-labelledby="about-title">
        <p class="eyebrow">GROWING THROUGH MAKING</p>
        <h2 id="about-title">완성된 앱도, 만드는 과정도.</h2>
        <p>궁금한 것을 발견하고, 직접 만들어 보고, 조금씩 고쳐 나가는 과정.<br class="desktop-break" /> 이 작업실은 결과물과 함께 그 과정에서 배운 것들을 기록하는 공간이에요.</p>
        <p class="about-note">첫 번째 게임 runningsmile부터, 다인이가 만든 앱을 하나씩 기록합니다.</p>
      </section>
    </main>
    <footer class="wrap"><span>DAIN'S APPS</span><p>작은 시작을 모아, 더 넓은 세상으로.</p></footer>
  </body>
</html>
