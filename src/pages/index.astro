---
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import '../styles/global.css';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="수학, 영어, 스도쿠, 그리고 게임. 마음에 드는 앱을 골라보세요." />
    <meta name="theme-color" content="#f5f1e8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>다인이의 앱 모음 · Dain's apps</title>
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 이동</a>
    <header class="site-header wrap">
      <a class="brand" href={import.meta.env.BASE_URL}><span aria-hidden="true">✦</span> DAIN'S APPS</a>
      <nav aria-label="주 메뉴"><a href="#projects">앱 모음</a></nav>
    </header>
    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-topline"><p class="eyebrow">DAIN’S APPS</p><span>MATH · ENGLISH · PUZZLE · GAME</span></div>
        <h1 id="hero-title" class="hero-title-ko"><span>다인이의</span><span class="hero-second">앱 모음<span class="hero-star" aria-hidden="true">✦</span></span></h1>
        <div class="hero-bottom"><p class="hero-description">수학, 영어, 스도쿠, 그리고 게임.<br />마음에 드는 앱을 골라보세요.</p><a class="browse-link" href="#projects">앱 둘러보기 <span aria-hidden="true">↘</span></a></div>
      </section>
      <section id="projects" class="projects-section" aria-labelledby="projects-title">
        <div class="section-heading"><div><p class="eyebrow">APPS</p><h2 id="projects-title">골라서 시작해요</h2></div><p>{String(projects.length).padStart(2, '0')}개의 앱</p></div>
        <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      </section>

    </main>
    <footer class="wrap"><span>DAIN'S APPS</span><p>dain.fun</p></footer>
  </body>
</html>
