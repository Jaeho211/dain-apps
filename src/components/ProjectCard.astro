---
import type { Project } from '../data/projects';
interface Props { project: Project }
const { project } = Astro.props;
const art: Record<string, string[]> = {
  'what-grade': ['÷', '＋'],
  'what-grade-english': ['Aa', '↗'],
  sudoku: ['▦', '123'],
  runningsmile: ['☺', '✦'],
};
const symbols = art[project.id] ?? ['✦', '＋'];
const imageSrc = project.image
  ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${project.image.src.replace(/^\//, '')}`
  : undefined;
---
<article class="project-card" data-project={project.id}>
  <div class="project-cover">
    {project.image ? (
      <img src={imageSrc} alt={project.image.alt} width="800" height="600" loading="lazy" />
    ) : (
      <div class="placeholder-art" aria-hidden="true">{symbols.map(symbol => <span class="art-symbol">{symbol}</span>)}</div>
    )}
    <span class="status">{project.status}</span>
  </div>
  <div class="project-body">
    <p class="eyebrow">{project.isPlaceholder ? 'COMING SOON' : 'MADE BY DAIN'}</p>
    <h3>{project.title}</h3>
    <p>{project.description}</p>
    {(project.firstRegisteredAt || project.lastModifiedAt) && (
      <dl class="project-dates" title="GitHub 커밋 기록 기준">
        {project.firstRegisteredAt && <div><dt>최초 등록</dt><dd><time datetime={project.firstRegisteredAt}>{project.firstRegisteredAt.replaceAll('-', '.')}</time></dd></div>}
        {project.lastModifiedAt && <div><dt>최근 수정</dt><dd><time datetime={project.lastModifiedAt}>{project.lastModifiedAt.replaceAll('-', '.')}</time></dd></div>}
      </dl>
    )}
    <ul class="tags" aria-label="프로젝트 키워드">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    {project.links?.length ? <div class="project-links">{project.links.map(link => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}</div> : null}
    {project.growthNotes.length > 0 && (
      <div class="growth-notes">
        <h4>만들며 배운 것</h4>
        <ul>{project.growthNotes.map(note => <li>
          {note.date && <time datetime={note.date}>{note.date}</time>}
          <strong>{note.title}</strong><p>{note.description}</p>
        </li>)}</ul>
      </div>
    )}
  </div>
</article>
